# ============================================================
#  MUMU codex code — 仓库根忽略规则
#  仓库结构：本目录即仓库根，各项目作为 monorepo 共存
# ============================================================

# ---------- 依赖 ----------
node_modules/
**/node_modules/

# ---------- 运行时状态 / 敏感数据 ----------
**/.browser-profile/

# ---------- 密钥 / 凭据 ----------
.env
.env.*
*.pem
*.key
*.pfx
*.p12

# ---------- 构建产物 ----------
dist/
build/dist/
out/
**/__pycache__/
*.pyc

# ---------- 日志与临时文件 ----------
*.log
*.tmp
~$*
Thumbs.db
desktop.ini
.DS_Store

# ---------- 编辑器 ----------
.idea/
.vscode/