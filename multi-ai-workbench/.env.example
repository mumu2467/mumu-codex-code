# ============================================================
#  multi-ai-workbench 环境变量模板
#  用法：复制为 .env（或直接在 shell 里 export），服务端启动时读取
# ============================================================

# ---------- 服务端 ----------
HOST=127.0.0.1
PORT=8787
LOG_LEVEL=info

# 运行时数据目录（SQLite、上传图片、浏览器登录态都会放这里）
# 留空则默认 <项目根>/storage
STORAGE_DIR=

# 单张图片上传上限（MB）
MAX_UPLOAD_MB=20

# ---------- 执行通道（每家可选 mock / playwright / api）----------
# Step 1-2 只有 mock 可用；playwright 在 Step 3 交付，api 在 Step 7 交付
ADAPTER_DEEPSEEK=mock
ADAPTER_DOUBAO=mock
ADAPTER_KIMI=mock

# mock 通道的语速倍率，越大越快（1 = 接近真人打字节奏）
MOCK_SPEED=1

# ---------- 路线 B：官方 API Key（Step 7 使用，先留空）----------
DEEPSEEK_API_KEY=
ARK_API_KEY=
MOONSHOT_API_KEY=