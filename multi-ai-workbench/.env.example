# ============================================================
#  multi-ai-workbench 环境变量模板
#  用法：复制为 .env（或直接在 shell 里 export），服务端启动时读取
# ============================================================

# ---------- 服务端 ----------
HOST=127.0.0.1
# 后端端口。改了它前端会自动跟着走（vite.config.ts 会读这里的 PORT）。
PORT=8787
LOG_LEVEL=info

# 运行时数据目录（SQLite、上传图片、浏览器登录态都会放这里）
# 留空则默认 <项目根>/storage
STORAGE_DIR=

# 单张图片上传上限（MB）
MAX_UPLOAD_MB=20

# ---------- 执行通道（每家可选 mock / playwright / api）----------
# mock       ：本地假数据，不联网、不需要登录（默认值，用来验证整条链路）
# playwright ：真实网页版通道：后端用浏览器窗口替你发消息并抓回复（Step 3b，需要先扫码登录）
# api        ：官方 API Key（Step 7）
ADAPTER_DEEPSEEK=mock
ADAPTER_DOUBAO=mock
ADAPTER_KIMI=mock

# mock 通道的语速倍率，越大越快（1 = 接近真人打字节奏）
MOCK_SPEED=1

# ---------- 路线 B：官方 API Key（Step 7 使用，先留空）----------
DEEPSEEK_API_KEY=
ARK_API_KEY=
MOONSHOT_API_KEY=

# ---------- Playwright 浏览器通道（Step 3）----------
# 是否无头运行。默认 false = 打开真实浏览器窗口，
# 这样你才能扫码 / 输验证码登录，也才能在窗口里人工介入。
BROWSER_HEADLESS=false

# 浏览器内核：留空用 Playwright 自带的 Chromium；
# 也可以填 chrome 直接复用本机已安装的 Chrome（更像真人环境，能少踩一些风控）。
BROWSER_CHANNEL=

# 每个动作后额外等待的毫秒数（调试选择器时设 200~500 很好用），默认 0
BROWSER_SLOWMO=0

# 等待人工完成登录的超时（毫秒），默认 5 分钟
LOGIN_TIMEOUT_MS=300000

# ---------- 前端（仅开发模式，端口冲突时很有用）----------
# 留空即可：Vite 会默认反代到上面的 PORT，自己监听 5173。
# 只有当你想让前端连"另一个"后端、或 5173 也被占了才需要填。
MAW_SERVER_PORT=
MAW_WEB_PORT=